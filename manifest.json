{
  "manifest_version": 2,
  "name": "Semantic Zotero",
  "version": "0.0.0",
  "description": "Shows the references of a paper from Semantic Scholar and adds them to Zotero with one click.",
  "author": "Tomáš Daniš, ILS",
  "icons": {
    "48": "content/icons/semanticzotero.svg",
    "96": "content/icons/semanticzotero.svg"
  },
  "applications": {
    "zotero": {
      "id": "semantic-zotero@ils-forschung.de",
      "update_url": "https://zotero.ils.local/downloads/semantic-zotero/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
